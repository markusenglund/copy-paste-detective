{
  "name": "copy-paste-detective",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "detect": "tsx -r dotenv/config src/commands/detect",
    "detect-multiple": "tsx -r dotenv/config src/commands/detectMultiple",
    "test-column-ai": "tsx -r dotenv/config src/commands/testColumnCategorizationPrompt",
    "list-gemini-models": "tsx -r dotenv/config src/commands/listGeminiModels",
    "dryad-index": "tsx -r dotenv/config src/commands/dryadIndex",
    "dryad-download": "tsx -r dotenv/config src/commands/dryadDownload",
    "dryad-get-dataset": "tsx -r dotenv/config src/commands/dryadGetDataset",
    "dryad-update": "tsx -r dotenv/config src/commands/dryadUpdate",
    "dryad-status": "tsx -r dotenv/config src/commands/dryadStatus",
    "dryad-detect": "LOG_LEVEL=debug tsx -r dotenv/config src/commands/dryadDetect",
    "dryad-detect-all": "tsx -r dotenv/config src/commands/dryadDetectAll",
    "dryad-report": "tsx -r dotenv/config src/commands/dryadReport",
    "dryad-mark-as-evaluated": "tsx -r dotenv/config src/commands/dryadMarkAsEvaluated",
    "dryad-find-sheets-within-sheet": "tsx -r dotenv/config src/commands/dryadFindSheetsWithinSheet",
    "openalex-search-article": "LOG_LEVEL=debug tsx -r dotenv/config src/commands/openalexSearchArticle",
    "openalex-connect-datasets": "LOG_LEVEL=debug tsx -r dotenv/config src/commands/openalexConnectDatasets",
    "pdf-download": "tsx -r dotenv/config src/commands/pdfDownload",
    "pdf-review": "tsx -r dotenv/config src/commands/pdfReview",
    "create-casefile": "tsx -r dotenv/config src/commands/createCasefile",
    "test-review-prompt": "tsx -r dotenv/config src/commands/testReviewPrompt",
    "backfill-pdf-metadata": "tsx -r dotenv/config src/scripts/backfillPdfMetadata.ts",
    "inspect-column-mapping": "tsx src/scripts/inspectColumnMapping.ts",
    "server": "NODE_ENV=production tsx -r dotenv/config src/server/index.ts",
    "server:dev": "nodemon --watch src --ext ts --exec 'tsx -r dotenv/config src/server/index.ts'",
    "web:dev": "vite --config src/web/vite.config.ts",
    "web:build": "vite build --config src/web/vite.config.ts",
    "dev": "concurrently \"npm run server:dev\" \"npm run web:dev\"",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "deploy:setup": "ansible-playbook deploy/setup.yml -i deploy/inventory.yml",
    "deploy": "ansible-playbook deploy/deploy.yml -i deploy/inventory.yml"
  },
  "author": "Markus Englund",
  "license": "UNLICENSED",
  "description": "",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jest": "^29.5.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^13.1.0",
    "@fast-csv/parse": "^5.0.5",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^9.0.0",
    "@google/genai": "^1.34.0",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.7.1",
    "iconv-lite": "^0.7.1",
    "jschardet": "^3.1.4",
    "lodash-es": "^4.17.21",
    "lowdb": "^7.0.1",
    "markdown-table": "^3.0.4",
    "p-map": "^7.0.3",
    "p-mutex": "^0.1.0",
    "p-retry": "^6.2.1",
    "p-throttle": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.3",
    "remark-gfm": "^4.0.1",
    "striptags": "^3.2.0",
    "undici": "^6.21.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  }
}
